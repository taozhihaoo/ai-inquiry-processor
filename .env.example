# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file — it is excluded by .gitignore.

# Provider selection: "mock" (offline demo, default for --demo) or "openai".
# LLM_PROVIDER=openai

# Required for real (non-mock) runs: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Resilience tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0

# Storage
AI_INQUIRY_DB_PATH=data/inquiries.db

# Optional cost estimation (USD per 1M tokens). Leave unset to disable;
# estimated_cost stays null unless BOTH prices and provider usage are available.
# LLM_PRICE_INPUT_PER_MTOK=0.15
# LLM_PRICE_OUTPUT_PER_MTOK=0.60
